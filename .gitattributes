# Auto detect text files and perform LF normalization
* text=auto

# Scripts and the Web UI are executed on Android. A CRLF line ending breaks
# the shebang ("/system/bin/sh^M: not found") and corrupts heredocs, so these
# are pinned to LF regardless of the checkout platform.
*.sh        text eol=lf
*.js        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.java      text eol=lf
*.gradle    text eol=lf
*.xml       text eol=lf
module/module.prop text eol=lf
module/META-INF/com/google/android/update-binary  text eol=lf
module/META-INF/com/google/android/updater-script text eol=lf

# Prebuilt binaries and databases must never be touched by EOL conversion.
module/bin/arm64-v8a/*  binary
module/bin/x86_64/*     binary
module/bin/*.dat        binary
*.jpg            binary
*.png            binary
*.zip            binary
app/src/main/jniLibs/**  binary
