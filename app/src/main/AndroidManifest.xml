<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by the Exclude apps tab to list every installed app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Non-root mode: the xray process runs under this app's uid and needs sockets. The WebView
         still blocks every http(s) request (see MainActivity), only the engine uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asks the user to exempt the app from battery optimisation (Doze). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the daily update-check job survive a reboot (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: v2rayng:// and magicv2ray:// install-config?url=<urlencoded subscription URL> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="v2rayng" android:host="install-config" />
                <data android:scheme="v2rayng" android:host="install-sub" />
                <data android:scheme="magicv2ray" android:host="install-config" />
                <data android:scheme="magicv2ray" android:host="install-sub" />
            </intent-filter>
            <!-- magicv2ray://add-provider?url=<site>&remark=<name> (add-privider: common misspelling) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magicv2ray" android:host="add-provider" />
                <data android:scheme="magicv2ray" android:host="add-privider" />
            </intent-filter>
            <!-- Long-press on the Quick Settings tile opens the app. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- External control (connect / disconnect). A translucent dialog that appears right over the app that asked,
             like Shizuku's permission prompt, instead of pulling Magic V2Ray to the front. -->
        <activity
            android:name=".ExternalPromptActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="standard"
            android:theme="@style/Theme.MV.Prompt">
            <!-- magicv2ray://connect?uri=<urlencoded>&name=<name>&exclude=<pkg,pkg> and magicv2ray://disconnect.
                 Every connect is confirmed by the user, see ExternalSession. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magicv2ray" android:host="connect" />
                <data android:scheme="magicv2ray" android:host="disconnect" />
            </intent-filter>
            <!-- Native apps: startActivity with this action and the extras uri / name / exclude. -->
            <intent-filter>
                <action android:name="com.huskydg.magicv2ray.action.CONNECT" />
                <action android:name="com.huskydg.magicv2ray.action.DISCONNECT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Mini browser for provider-website categories (sandboxed: no root bridge). -->
        <activity
            android:name=".ProviderBrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|locale|layoutDirection"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Non-root engine: a VpnService that hands its tun fd to xray. -->
        <service
            android:name=".MagicVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Daily background update check (App settings -> Auto update check). -->
        <!-- adb pairing from a notification (code typed in the notification, see AdbPairingService). -->
        <service
            android:name=".AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="adb_pairing_notification" />
        </service>
        <receiver
            android:name=".AdbPairReplyReceiver"
            android:exported="false" />

        <service
            android:name=".UpdateJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- sendBroadcast entry of the external control API (see ExternalControlReceiver). -->
        <receiver
            android:name=".ExternalControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.huskydg.magicv2ray.action.CONNECT" />
                <action android:name="com.huskydg.magicv2ray.action.DISCONNECT" />
                <action android:name="com.huskydg.magicv2ray.action.GET_INFO" />
                <!-- from the root service (am broadcast): only makes the app re-read the engine status -->
                <action android:name="com.huskydg.magicv2ray.action.ENGINE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Read-only info / state of the external API (see ExternalApiProvider). No permission: it holds no secrets. -->
        <provider
            android:name=".ExternalApiProvider"
            android:authorities="com.huskydg.magicv2ray.api"
            android:exported="true" />

        <!-- Share proxy without Shizuku: the app_process helper (HotspotMain) delivers its Binder here.
             Exported because the sender is the shell user; the sender is authenticated by a one-time nonce. -->
        <receiver
            android:name=".HotspotBinderReceiver"
            android:exported="true" />

        <!-- One-time adb pairing for the no-Shizuku hotspot helper. -->
        <activity
            android:name=".AdbPairActivity"
            android:exported="false"
            android:label="@string/adb_title" />

        <!-- "Turn off proxy" button of the status notification. -->
        <receiver
            android:name=".StopProxyReceiver"
            android:exported="false" />

        <!-- Share proxy via Shizuku: Shizuku delivers its binder to the app through this provider. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Quick Settings tile: tap toggles the core, long-press opens the app. -->
        <service
            android:name=".CoreTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
