<?xml version="1.0" encoding="utf-8"?>
<!-- adb pairing screen: same Material 3 tokens, cards and pill buttons as the setup / welcome screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mv_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/adb_title"
            android:textColor="@color/mv_on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/adb_subtitle"
            android:textColor="@color/mv_on_surface_variant"
            android:textSize="14sp" />

        <!-- Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/adb_status_badge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/adb_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/mv_on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/adb_status_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/mv_on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Result of the last attempt -->
        <TextView
            android:id="@+id/adb_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/mv_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Steps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_mode_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/adb_steps_title"
                android:textAllCaps="true"
                android:textColor="@color/mv_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_step_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/mv_on_primary_container"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/adb_step1"
                    android:textColor="@color/mv_on_surface"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_step_badge"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/mv_on_primary_container"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/adb_step2"
                    android:textColor="@color/mv_on_surface"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_step_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/mv_on_primary_container"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/adb_step3"
                    android:textColor="@color/mv_on_surface"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/adb_btn_notification"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_btn_filled"
                android:minHeight="52dp"
                android:text="@string/adb_btn_notification"
                android:textAllCaps="false"
                android:textColor="@color/mv_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/adb_btn_open_dev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_tonal"
                android:minHeight="52dp"
                android:text="@string/adb_btn_open_dev"
                android:textAllCaps="false"
                android:textColor="@color/mv_on_secondary_container"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TCP mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_mode_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/adb_tcp_title"
                    android:textColor="@color/mv_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/adb_tcp_desc"
                    android:textColor="@color/mv_on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/adb_tcp_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/adb_tcp_title" />
        </LinearLayout>

        <!-- Manual entry (fallback) -->
        <Button
            android:id="@+id/adb_btn_manual_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_text"
            android:minHeight="48dp"
            android:text="@string/adb_manual_toggle"
            android:textAllCaps="false"
            android:textColor="@color/mv_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/adb_manual_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_mode_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/adb_manual_title"
                android:textAllCaps="true"
                android:textColor="@color/mv_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/adb_manual_note"
                android:textColor="@color/mv_on_surface_variant"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/adb_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="@string/adb_hint_port"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:minHeight="52dp"
                android:padding="16dp"
                android:singleLine="true"
                android:textColor="@color/mv_on_surface"
                android:textColorHint="@color/mv_on_surface_variant"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/adb_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/adb_hint_code"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6"
                android:minHeight="52dp"
                android:padding="16dp"
                android:singleLine="true"
                android:textColor="@color/mv_on_surface"
                android:textColorHint="@color/mv_on_surface_variant"
                android:textSize="16sp" />

            <Button
                android:id="@+id/adb_btn_pair"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_tonal"
                android:minHeight="52dp"
                android:text="@string/adb_btn_pair"
                android:textAllCaps="false"
                android:textColor="@color/mv_on_secondary_container"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
