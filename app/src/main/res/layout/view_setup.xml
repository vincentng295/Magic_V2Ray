<?xml version="1.0" encoding="utf-8"?>
<!-- Progress / error screen shown while the engine is prepared. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mv_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/setup_logo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_logo"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/logo_badge" />

        <ImageView
            android:id="@+id/setup_error_icon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_badge_error"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_warning"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/mv_on_primary_container"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/setup_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/mv_primary" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/mv_on_surface_variant"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/setup_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_retry"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_filled"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/mv_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_nonroot"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_tonal"
                android:text="@string/use_nonroot"
                android:textAllCaps="false"
                android:textColor="@color/mv_on_secondary_container"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_exit"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_text"
                android:text="@string/exit"
                android:textAllCaps="false"
                android:textColor="@color/mv_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
