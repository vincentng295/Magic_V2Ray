<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable mode card: rounded surface with a ripple clipped to the same shape. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mv_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mv_surface_container" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#33CAC4D0" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
