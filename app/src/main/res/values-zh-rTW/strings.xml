    <string name="adb_title">adb 配對</string>
    <string name="adb_subtitle">無需 Shizuku，透過熱點分享代理</string>
    <string name="adb_status_paired">已配對</string>
    <string name="adb_status_unpaired">未配對</string>
    <string name="adb_status_paired_desc">每次開始分享時，請開啟無線偵錯（並連上 Wi-Fi）。</string>
    <string name="adb_status_unpaired_desc">只需配對一次，即可在沒有 Shizuku 的情況下分享。</string>
    <string name="adb_steps_title">配對步驟</string>
    <string name="adb_step1">連上 Wi-Fi，並在開發人員選項中開啟無線偵錯。</string>
    <string name="adb_step2">輕觸「使用配對碼配對裝置」，並保持該對話框開啟。</string>
    <string name="adb_step3">在隨後出現的通知中輸入 6 位數配對碼。</string>
